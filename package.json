{
  "name": "newton-submit-mcp",
  "version": "1.2.0",
  "description": "MCP server for Newton School platform APIs, problem fetching, code sync, and automated runner evaluation",
  "type": "module",
  "bin": {
    "newton-submit-mcp": "./build/index.js",
    "newton-school-mcp": "./build/index.js"
  },
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
